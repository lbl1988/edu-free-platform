// 全国K-12免费教育学习平台 · Prisma Schema
// 对应交接报告 CH7 数据库设计概览
//
// 设计说明：
// 1. 数据库为 PostgreSQL 16 + pgvector 扩展（第二期 LightRAG 启用向量列）
// 2. 主键统一使用 cuid()，避免自增 ID 暴露数据规模
// 3. 报告建议"不建物理外键约束，应用层维护关系完整性"——本 schema 为保证数据
//    完整性仍使用 Prisma 标准外键（数据库级约束），如需切换为 relationMode=prisma
//    可后续调整，不影响业务层代码
// 4. 软删除统一通过 deletedAt 字段实现，不物理删除用户数据（符合未成年人保护与审计要求）

generator client {
  provider      = "prisma-client-js"
  // 输出到 node_modules/.prisma/client（默认），无需额外配置
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举 ====================

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum BoardType {
  CLASSROOM
  EXTRACURRICULAR
  COMPETITION
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamType {
  FORMAL
  MOCK
}

enum ExamStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
  VIOLATION_SUBMIT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  FILL_BLANK
  ESSAY
  CODING
}

enum ReviewStatus {
  PENDING
  AI_PASSED
  AI_REJECTED
  REVIEWER_PASSED
  REVIEWER_REJECTED
  EXPERT_PASSED
  EXPERT_REJECTED
}

enum TaskStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum RealNameStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ==================== 用户域 ====================

model User {
  id                   String          @id @default(cuid())
  phone                String          @unique
  passwordHash         String
  nickname             String?
  avatarUrl            String?
  role                 Role            @default(STUDENT)
  grade                Int?            // 1-12 年级
  agentUserId          String?         // EduAgent 绑定 ID（第二期）
  qaCollectionEnabled  Boolean         @default(true) // 是否允许采集 QA 日志用于优化
  realNameStatus       RealNameStatus  @default(UNVERIFIED)
  realName             String?         // 实名认证姓名（脱敏存储）
  idCardHash           String?         // 身份证号哈希（不存明文）
  // 防沉迷：未成年人每日累计学习时长上限（分钟），成人 null
  dailyLimitMinutes    Int?            @default(120)
  lastLoginAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  parentBindingsAsParent  ParentBinding[] @relation("ParentToBinding")
  parentBindingsAsStudent ParentBinding[] @relation("StudentToBinding")
  learningProfile      LearningProfile?
  volunteerCerts       VolunteerCert[]
  // 内容域关系
  coursesAsTeacher     Course[]
  courseEnrollments    CourseEnrollment[]
  notes                Note[]
  // 题库刷题域
  answers              QuestionAnswer[]
  wrongRecords         WrongRecord[]
  favorites            Favorite[]
  paperAttempts        PaperAttempt[]
  practicePapers       PracticePaper[] @relation("PracticePaperCreator")
  examsAsCreator       Exam[]          @relation("ExamCreator")

  examResults          ExamResult[]
  refreshTokens        RefreshToken[]
  uploadedMaterials    Material[]
  // 竞赛域
  contestsAsCreator    Contest[]       @relation("ContestCreator")
  contestEnrollments   ContestEnrollment[]
  contestSubmissions   ContestSubmission[]
  // 课外知识
  authoredArticles     Article[]       @relation("ArticleAuthor")
  // 课程 AI 聊天会话（第二期）
  chatSessions         CourseChatSession[]

  @@index([role])
  @@index([grade])
  @@index([deletedAt])
}

/// 家长绑定：一个学生可绑定多位家长，一位家长可关联多个子女
model ParentBinding {
  id          String   @id @default(cuid())
  parentId    String
  parent      User     @relation("ParentToBinding", fields: [parentId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("StudentToBinding", fields: [studentId], references: [id], onDelete: Cascade)
  // 绑定凭证码（学生生成一次性码，家长凭码绑定）
  bindCodeHash String?
  verified     Boolean @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// 学习画像：聚合学生学情数据，供推荐系统使用
model LearningProfile {
  id                String   @id @default(cuid())
  studentId         String   @unique
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 薄弱知识点 JSON：[{ subjectId, chapterId, mastery: 0-1 }]
  weakPoints        Json     @default("[]")
  // 学习偏好 JSON：偏好学科、难度、时段
  preferences       Json     @default("{}")
  totalStudyMinutes Int      @default(0)
  totalQuestions    Int      @default(0)
  correctRate       Float    @default(0)
  streakDays        Int      @default(0)
  lastActiveAt      DateTime?
  updatedAt         DateTime @updatedAt

  @@index([lastActiveAt])
}

// 课程 AI 聊天会话：每门课程每个学生一条会话记录（含历史消息）
model CourseChatSession {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 消息历史：[{ role: 'user' | 'assistant', content, citations?:[], ts }]
  messages   Json     @default("[]")
  messageCount Int   @default(0)
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
}

/// 志愿者认证：专家/教师志愿者贡献课程的认证记录
model VolunteerCert {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      VolunteerStatus @default(PENDING)
  // 认证类型：学科专家 / 一线教师 / 高校志愿者
  certType    String
  expertise   String[]        // 擅长学科领域
  orgName     String?         // 所属机构
  intro       String?
  // 贡献积分：可兑换线下学术活动参与资格
  points      Int             @default(0)
  reviewedBy  String?         // 审核管理员 ID
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([userId])
}

/// Refresh Token：单次消费，事务化校验防重放
model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // token 哈希存储，不存明文
  tokenHash   String   @unique
  // 设备/客户端指纹，便于多端管理
  userAgent   String?
  ipAddr      String?
  expiresAt   DateTime
  revokedAt   DateTime? // 主动登出或刷新后置空
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ==================== 内容域（骨架，第二期完善）====================

model Subject {
  id        Int      @id
  name      String
  stage     String   // PRIMARY | JUNIOR | SENIOR
  createdAt DateTime @default(now())

  courses        Course[]
  questions      Question[]
  textbooks      Textbook[]
  practicePapers PracticePaper[]
  exams          Exam[]
  contests       Contest[]
  articles       Article[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id])
  grade       Int
  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  boardType   BoardType
  status      CourseStatus @default(DRAFT)
  intro       String?
  coverUrl    String?
  // 教材版本（人教/北师大/苏教等），课堂学科板块必填，课外/竞赛可为空
  textbookId  String?
  textbook    Textbook?    @relation(fields: [textbookId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments CourseEnrollment[]
  lessons     Lesson[]
  materials   Material[]
  // 课程 AI 聊天会话（第二期）
  chatSessions CourseChatSession[]
  // 第三期：竞赛关联
  contestsAsCourse  Contest[]  @relation("ContestLinkedCourse")

  @@index([grade, subjectId])
  @@index([boardType, status])
  @@index([teacherId])
  @@index([textbookId])
}

/// 教材版本：按"年级—学科—教材版本"组织目录
model Textbook {
  id        String   @id @default(cuid())
  name      String   // 人教版 / 北师大版 / 苏教版
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  grade     Int
  publisher String?  // 出版社
  createdAt DateTime @default(now())

  courses   Course[]
  chapters  Chapter[]

  @@unique([subjectId, grade, name])
  @@index([grade, subjectId])
}

/// 章节：五级目录中的"章节"层，支持树形结构
model Chapter {
  id          String     @id @default(cuid())
  textbookId  String
  textbook    Textbook   @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  parentId    String?    // 父章节，null 为根章节
  parent      Chapter?   @relation("ChapterTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Chapter[]  @relation("ChapterTree")
  title       String
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  knowledgePoints KnowledgePoint[]
  lessons         Lesson[]
  questions       Question[]
  articles        Article[]

  @@index([textbookId, parentId])
  @@index([sortOrder])
}

/// 知识点：五级目录最底层，关联章节与题目
model KnowledgePoint {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  // 知识点描述，供 AI 生成题目与摘要参考
  description String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([chapterId])
}

/// 课时：课程下的具体教学单元，关联章节与视频
model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  title       String
  intro       String?
  sortOrder   Int      @default(0)
  durationSec Int?     // 视频时长（秒），由转码回填
  video       Video?
  notes       Note[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, sortOrder])
  @@index([chapterId])
}

/// 视频：课时关联的视频资源，存储于 MinIO
model Video {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // MinIO 对象 key（非完整 URL，由 CDN/签名拼接）
  objectKey    String
  // 转码后的多清晰度 HLS 清单 key
  hlsKey       String?
  durationSec  Int?
  fileSize     Int?
  // 字幕（Whisper 生成，第二期 AI 引擎回填）
  subtitleUrl  String?
  // 转码状态
  transcodeStatus String @default("PENDING") // PENDING | PROCESSING | READY | FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([transcodeStatus])
}

/// 课件资料：课程级附件（PDF/Word/PPT），存储于 MinIO
model Material {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  // MinIO 对象 key
  objectKey   String
  fileType    String   // pdf | docx | pptx | zip
  fileSize    Int?
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  createdAt   DateTime @default(now())

  @@index([courseId])
}

/// 课堂笔记：学生在课时下的个人笔记
model Note {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content   String
  // 视频时间戳锚点（秒），可空
  anchorSec Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

model Question {
  id            String        @id @default(cuid())
  content       String
  options       Json?         // 选择题选项
  answer        String?
  analysis      String?
  videoUrl      String?
  difficulty    Int           // 1-5
  subjectId     Int
  subject       Subject       @relation(fields: [subjectId], references: [id])
  grade         Int?
  chapterId     String?
  chapter       Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questionType  QuestionType
  source        String?       // 中考/高考/模拟/竞赛/AI生成
  sourceYear    Int?
  aiGenerated   Boolean       @default(false)
  reviewStatus  ReviewStatus  @default(PENDING)
  // 答题统计（缓存，异步更新，避免重复统计）
  attemptCount  Int           @default(0)
  correctCount  Int           @default(0)
  createdAt     DateTime      @default(now())

  answers         QuestionAnswer[]
  wrongRecords    WrongRecord[]
  favorites       Favorite[]
  paperQuestions  PaperQuestion[]
  examQuestions   ExamQuestion[] @relation("SrcQuestion")

  @@index([subjectId, grade])
  @@index([difficulty])
  @@index([reviewStatus])
  @@index([source, sourceYear])
  @@index([chapterId])
  @@index([correctCount, attemptCount])
}

// ==================== 题库刷题域 ====================

/// 练习试卷：教师/AI 智能组卷，供学生练习（区别于 Exam 的正式考试）
model PracticePaper {
  id            String     @id @default(cuid())
  title         String
  creatorId     String?    // 教师或管理员创建；AI 组卷可空
  creator       User?      @relation("PracticePaperCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  subjectId     Int
  subject       Subject    @relation(fields: [subjectId], references: [id])
  grade         Int?
  // 生成方式：MANUAL 手动选 | AI_SMART AI智能组卷 | RANDOM 随机
  mode          String     @default("MANUAL")
  // 组卷参数 JSON：{ 题数、难度分布、知识点权重 }
  params        Json?
  totalScore    Int        @default(100)
  durationMin   Int?       // 建议时长（分钟）
  published     Boolean    @default(true)
  createdAt     DateTime   @default(now())

  questions     PaperQuestion[]
  attempts      PaperAttempt[]
  derivedExams  Exam[]         @relation("PaperToExam")

  @@index([subjectId, grade])
  @@index([published, createdAt])
}

/// 试卷-题目关联（多对多，带序号）
model PaperQuestion {
  id          String        @id @default(cuid())
  paperId     String
  paper       PracticePaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder   Int           @default(0)
  // 该题在卷中分值
  score       Int           @default(5)

  @@unique([paperId, questionId])
  @@index([paperId, sortOrder])
}

/// 学生答题记录：单题作答（独立于试卷，也可用于逐题练习模式）
model QuestionAnswer {
  id            String     @id @default(cuid())
  questionId    String
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 学生作答内容；选择题为选项字母（JSON 数组多选）
  answer        String?
  // 主观题由 AI 评分（第二期），客观题立即判分
  score         Float?
  isCorrect     Boolean?
  // 答题耗时（秒）
  usedSec       Int?
  // 所属答题尝试（optional），用于按试卷分组统计
  attemptId     String?
  attempt       PaperAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([studentId, questionId])
  @@index([isCorrect])
  @@index([attemptId])
}

/// 错题本：答错后自动加入，可手动移除
model WrongRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // 最新一次错答内容
  lastWrongAnswer String?
  // 连续错误次数（提示复习强度）
  wrongCount  Int      @default(1)
  // 是否已重做并答对（软标记，可用于筛选）
  mastered    Boolean  @default(false)
  firstWrongAt DateTime @default(now())
  lastWrongAt  DateTime @default(now())
  masteredAt   DateTime?

  @@unique([studentId, questionId])
  @@index([studentId, mastered])
}

/// 题目收藏
model Favorite {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, questionId])
}

/// 试卷答题尝试：学生在某张练习卷的一次作答
model PaperAttempt {
  id          String      @id @default(cuid())
  paperId     String
  paper       PracticePaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId   String
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Float?
  totalScore  Int         @default(100)
  correctCount Int        @default(0)
  totalCount  Int         @default(0)
  startedAt   DateTime    @default(now())
  submittedAt DateTime?
  // 作答状态：IN_PROGRESS | SUBMITTED
  status      String      @default("IN_PROGRESS")

  answers     QuestionAnswer[]

  @@index([studentId, paperId])
  @@index([status])
  @@unique([paperId, studentId, status, submittedAt])
}

// ==================== 考试域（第一期：在线考试服务）====================

model Exam {
  id             String        @id @default(cuid())
  title          String
  examType       ExamType      // FORMAL 正式 | MOCK 模拟
  subjectId      Int
  subject        Subject       @relation(fields: [subjectId], references: [id])
  grade          Int
  // 时间窗口：允许进入时段 [startTime, endTime]；进入后单独计时 duration 分钟
  startTime      DateTime
  endTime        DateTime
  duration       Int           // 分钟（进入后倒计时）
  maxCheating    Int           @default(3) // 最大违规次数，超阈值自动标记 VIOLATION_SUBMIT
  creatorId      String
  creator        User          @relation("ExamCreator", fields: [creatorId], references: [id])
  // 题目：直接关联题库题（与 PracticePaper 独立，便于正式考试选题冻结）
  questions      ExamQuestion[]
  // 可选：基于练习卷快速生成考试（题目从卷中复制）
  sourcePaperId  String?
  sourcePaper    PracticePaper? @relation("PaperToExam", fields: [sourcePaperId], references: [id], onDelete: SetNull)
  totalScore     Int           @default(100)
  // 发布控制：草稿时学生不可见；归档后不可进入
  status         CourseStatus  @default(DRAFT)  // 复用 CourseStatus: DRAFT|PUBLISHED|ARCHIVED
  // 防作弊：允许重考次数（默认 0 = 仅一次）
  retryAllowed   Int           @default(0)
  // 学生端提交即自动评分客观题；主观题由教师人工批改
  aiAutoGrade    Boolean       @default(true)
  passScore      Float?        // 及格分（可选）
  createdAt      DateTime      @default(now())

  results        ExamResult[]
  // 第三期：竞赛复用 Exam（一场正式竞赛 = 一次 Exam）
  contestsAsExam Contest[]  @relation("ContestLinkedExam")

  @@index([subjectId, grade])
  @@index([examType, startTime])
  @@index([creatorId])
  @@index([status])
}

/// 考试题目（与题库 Question 解耦，保存考试当时的快照，避免题目后续修改影响已发考试）
model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  // 原题库题 ID（可空：纯手动创建的考试题）
  srcQuestionId String?
  srcQuestion  Question? @relation("SrcQuestion", fields: [srcQuestionId], references: [id], onDelete: SetNull)
  // 题目快照
  content      String
  options      Json?
  questionType QuestionType
  difficulty   Int
  answer       String?
  analysis     String?
  sortOrder    Int      @default(0)
  // 单题分值
  perScore     Int      @default(5)

  answers      ExamAnswer[]

  @@unique([examId, sortOrder])
  @@index([examId])
}

model ExamResult {
  id              String     @id @default(cuid())
  examId          String
  exam            Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       String
  student         User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 得分
  score           Float?
  objectiveScore  Float?     // 客观题得分
  subjectiveScore Float?     // 主观题得分（教师批改，第一期支持手动录入分数）
  totalScore      Int        @default(100) // 当时考试总分快照
  status          ExamStatus @default(NOT_STARTED)
  // 时间线
  startTime       DateTime?  // 进入考试时间
  deadline        DateTime?  // 应交卷时间（startTime + duration）
  submitTime      DateTime?  // 实际交卷时间
  // 答题统计
  correctCount    Int        @default(0)
  totalCount      Int        @default(0)
  // IP 快照
  startIp         String?
  endIp           String?
  // 作弊计数
  cheatingCount   Int        @default(0)
  // 是否已手动批改（主观题）
  graded          Boolean    @default(false)
  gradedBy        String?
  gradedAt        DateTime?
  createdAt       DateTime   @default(now())

  violations      ExamViolation[]
  answers         ExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id           String   @id @default(cuid())
  resultId     String
  result       ExamResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id])
  answer       String?
  isCorrect    Boolean?
  aiScore      Float?
  finalScore   Float?
  perScore     Int      // 快照：考试当时该题分值
  answeredAt   DateTime @default(now())
  // 快速答题判定（< 3 秒视为作弊线索）
  answeredFast Boolean?

  @@index([resultId])
  @@index([examQuestionId])
}

model ExamViolation {
  id        String   @id @default(cuid())
  resultId  String
  result    ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  type      String   // fullscreen_exit | tab_switch | copy_attempt | ip_change | fast_answer | overdue
  detail    String?
  occurredAt DateTime @default(now())

  @@index([resultId])
  @@index([type])
}

// ==================== AI 内容域（骨架，第二期完善）====================

model AIGenTask {
  id          String     @id @default(cuid())
  genType     String     // question | summary | subtitle
  params      Json
  status      TaskStatus @default(QUEUED)
  result      Json?
  errorMessage String?
  createdAt   DateTime   @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([genType, status])
}

model CrawlTask {
  id            String     @id @default(cuid())
  source        String     // 采集源 URL
  resourceType  String     // exam_paper | contest | open_course | textbook
  region        String?    // 省份
  year          Int?
  status        TaskStatus @default(QUEUED)
  result        Json?
  errorMessage  String?
  createdAt     DateTime   @default(now())
  processedAt   DateTime?

  @@index([status])
}

model ContentReview {
  id           String        @id @default(cuid())
  targetType   String        // question | summary | material
  targetId     String
  reviewStage  String        // ai | reviewer | expert
  status       ReviewStatus
  reviewerId   String?
  comment      String?
  createdAt    DateTime      @default(now())
  reviewedAt   DateTime?

  @@index([targetType, targetId])
  @@index([status])
}

// ==================== 课外知识域（第三期骨架）====================

/// 课外文章 / 知识卡片：科学探索、人文历史、艺术启蒙等拓展内容
model Article {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  summary         String?
  content         String      // 富文本 HTML 或 Markdown 源
  coverUrl        String?
  boardType       BoardType   @default(EXTRACURRICULAR) // EXTRACURRICULAR | COMPETITION（竞赛资讯复用）
  category        String      // 一级分类：sciences | humanities | arts | contest-news | ...
  tags            String[]
  // 关联知识点（可选），用于知识图谱与推荐
  subjectId       Int?
  subject         Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  grade           Int?
  chapterId       String?
  chapter         Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  // 来源：人工编辑 | AI 生成 | 公开授权采集
  source          String?
  sourceUrl       String?
  authorId        String?
  author          User?       @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  viewCount       Int         @default(0)
  likeCount       Int         @default(0)
  reviewStatus    ReviewStatus @default(REVIEWER_PASSED)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([boardType, category])
  @@index([subjectId, grade])
  @@index([reviewStatus, publishedAt])
  @@index([slug])
}

// ==================== 竞赛域（第三期：竞赛服务 + OJ 判题）====================

model Contest {
  id                String        @id @default(cuid())
  title             String
  shortTitle        String?       // 如 CSP-J 2026
  // 教育部白名单赛事标记
  whitelist         Boolean       @default(false)
  subjectId         Int
  subject           Subject       @relation(fields: [subjectId], references: [id])
  stage             String        // 初赛/复赛/决赛 | 省级/国家级
  year              Int
  startTime         DateTime
  endTime           DateTime
  durationMin       Int           // 竞赛时长（分钟）
  // 说明与奖励
  intro             String?
  awardInfo         String?
  // 竞赛关联的课程（竞赛教程）
  courseId          String?
  course            Course?       @relation("ContestLinkedCourse", fields: [courseId], references: [id], onDelete: SetNull)
  // 关联考试题（可复用 Exam 作为一次正式竞赛的题目与答题）
  examId            String?
  exam              Exam?         @relation("ContestLinkedExam", fields: [examId], references: [id], onDelete: SetNull)
  creatorId         String
  creator           User          @relation("ContestCreator", fields: [creatorId], references: [id])
  published         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  enrollments       ContestEnrollment[]
  problems          ContestProblem[]
  submissions       ContestSubmission[]

  @@index([subjectId, year])
  @@index([whitelist, startTime])
  @@index([published])
}

model ContestEnrollment {
  id          String   @id @default(cuid())
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 报名信息
  school      String?
  province    String?
  city        String?
  enrolledAt  DateTime @default(now())

  @@unique([contestId, studentId])
  @@index([studentId])
}

/// OJ 题目（竞赛编程题）：与普通 Question 解耦，提供输入输出样例、时间内存限制
model ContestProblem {
  id              String       @id @default(cuid())
  contestId       String
  contest         Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  // 在竞赛中的编号：A/B/C 或 1001/1002
  problemCode     String
  title           String
  description     String       // 题目描述（Markdown/富文本）
  inputFormat     String?
  outputFormat    String?
  // 样例：[{ input, output, note }] JSON
  samples         Json         @default("[]")
  timeLimitMs     Int          @default(1000)
  memoryLimitMB   Int          @default(128)
  difficulty      Int          // 1-5
  // 判定数据（MinIO 对象 key：zip 包中包含 *.in/*.out）
  testdataKey     String?
  totalSubmit     Int          @default(0)
  totalAccept     Int          @default(0)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  submissions     ContestSubmission[]

  @@unique([contestId, problemCode])
  @@index([contestId, sortOrder])
}

enum JudgeVerdict {
  PENDING
  JUDGING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
  PRESENTATION_ERROR
  SYSTEM_ERROR
}

/// OJ 提交记录：考生提交的源码由 Docker 沙箱判题
model ContestSubmission {
  id            String        @id @default(cuid())
  contestId     String
  contest       Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId     String
  problem       ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  studentId     String
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 语言：C | C++ | Java | Python | JavaScript | Go | Pascal | Rust
  language      String
  sourceCode    String        // 源码文本（加密存储可选）
  codeLength    Int
  // 判题结果
  verdict       JudgeVerdict  @default(PENDING)
  score         Int?          // IOI 赛制得分 0-100，ACM 赛制 100=AC
  runTimeMs     Int?
  runMemoryKB   Int?
  // 编译/运行错误信息（脱敏后前端可展示）
  message       String?
  // 沙箱任务 ID（异步判题时跟踪）
  judgeTaskId   String?
  judgedAt      DateTime?
  createdAt     DateTime      @default(now())

  @@index([contestId, problemId])
  @@index([studentId, contestId])
  @@index([verdict])
  @@index([judgeTaskId])
}

// ==================== 推荐与行为域（第四期骨架，ClickHouse 明细 + PG 聚合）====================

/// 推荐召回候选缓存：离线任务每日写入，线上直接读取
model RecallItem {
  id         String   @id @default(cuid())
  studentId  String
  // 推荐场景：dashboard | course_detail | after_exam | extracurricular
  scene      String
  // 推荐项类型：course | question | article | contest | exam
  itemType   String
  itemId     String
  score      Float    // 召回得分，用于排序
  // 召回来源：popular | collaborative | content | knowledge_graph | u2i
  source     String
  rank       Int
  createdAt  DateTime @default(now())

  @@index([studentId, scene])
  @@index([itemType, itemId])
}

/// 用户聚合行为摘要（ClickHouse 明细同步到 PG，用于特征）
model UserBehaviorSummary {
  id                String   @id @default(cuid())
  studentId         String   @unique
  // 近 7 / 30 天学习时长（分钟）
  minutesLast7d     Int      @default(0)
  minutesLast30d    Int      @default(0)
  // 近 30 天答题数 / 正确率
  questionsLast30d  Int      @default(0)
  correctLast30d    Float    @default(0)
  // 学科兴趣分布 JSON：{ [subjectId]: 权重 0-1 }
  subjectWeights    Json     @default("{}")
  // 最近一次会话时间
  lastSessionAt     DateTime?
  // 累计访问次数
  visitCount        Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([lastSessionAt])
}
