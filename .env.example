# ========== 数据库 ==========
# PostgreSQL (pgvector)，与 docker-compose.yml 一致
DATABASE_URL="postgresql://edu:edu@localhost:5432/edu_platform?schema=public"

# ========== Redis ==========
REDIS_URL="redis://localhost:6379"

# ========== MinIO (S3 兼容对象存储) ==========
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_minio_minio
MINIO_BUCKET=edu-materials
MINIO_USE_SSL=false

# ========== 安全密钥（三者互不相同，≥16 字符）==========
# 生成方式 (PowerShell):
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET="change-me-jwt-secret-at-least-32-chars-long"
CREDENTIAL_CODE_PEPPER="change-me-credential-pepper-32-chars"
BIND_CREDENTIAL_API_KEY="change-me-bind-api-key-32-chars"
INTERNAL_API_KEY="change-me-internal-api-key-32-chars"

# ========== JWT 配置 ==========
JWT_ACCESS_EXPIRES="15m"        # access token 有效期
JWT_REFRESH_EXPIRES="30d"       # refresh token 有效期
JWT_ISSUER="edu-free-platform"

# ========== EduAgent 网关（课程AI问答，第二期）==========
EDU_AGENT_BASE_URL="http://127.0.0.1:8765"
EDU_AGENT_API_KEY=""

# ========== 应用配置 ==========
APP_NAME="全国K-12免费教育学习平台"
APP_ENV="development"
# 种子管理员密码（≥12 位），仅 db:seed 时使用
SEED_ADMIN_PASSWORD="change-me-seed-admin-pwd-12"
